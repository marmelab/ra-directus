{
    "name": "ra-directus",
    "version": "3.0.0",
    "repository": "git@github.com:marmelab/ra-directus.git",
    "authors": [
        "Thibault Barrat <thibault@marmelab.com> (https://marmelab.com/)",
        "Gildas Garcia <gildas@marmelab.com> (https://marmelab.com/)"
    ],
    "license": "MIT",
    "files": [
        "*.md",
        "dist",
        "src"
    ],
    "type": "module",
    "zshy": {
        "exports": "./src/index.ts",
        "noEdit": true
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "sideEffects": false,
    "peerDependencies": {
        "react-admin": "^5.1.1"
    },
    "dependencies": {
        "jwt-decode": "^3.1.2"
    },
    "scripts": {
        "build": "zshy",
        "lint": "eslint --fix ./src"
    },
    "devDependencies": {
        "@directus/sdk": "^10.3.1",
        "@types/jest": "^29.1.0",
        "jest": "^29.1.1",
        "jest-environment-jsdom": "^29.1.1",
        "ts-jest": "^29.0.3",
        "typescript": "^5.5.4",
        "zshy": "^0.8.0"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "jsdom",
        "collectCoverageFrom": [
            "**/*.js",
            "**/*.ts",
            "!__tests__/util.ts",
            "!coverage/**",
            "!**/node_modules/**"
        ],
        "verbose": true,
        "automock": false,
        "clearMocks": true,
        "testPathIgnorePatterns": [
            "/node_modules/"
        ],
        "moduleFileExtensions": [
            "ts",
            "tsx",
            "js",
            "jsx",
            "json",
            "node"
        ]
    }
}
